PORT=3001
# Optional SQLite path; relative paths resolve from the server directory.
DB_PATH=./data/eventsync.sqlite
# Vite's development proxy target. Restart Vite after changing this value.
API_PROXY_TARGET=http://127.0.0.1:3001

# IANA timezone used only to determine current venue-local time for the dashboard.
VENUE_TIME_ZONE=UTC

# Browser origin allowed for state-changing requests. Use the actual HTTPS origin in production.
APP_ORIGIN=http://localhost:5173
# NODE_ENV=production requires HTTPS APP_ORIGIN and enables Secure session cookies.
